{
  "$schema": "https://opencode.ai/config.json",

  "model": "tokenrouter/deepseek/deepseek-v4-pro-0813",

  "instructions": [
    "AGENTS.md"
  ],

  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",

      "options": {
        "baseURL": "https://api.tokenrouter.com/v1"
      },

      "models": {
        "anthropic/claude-opus-5-fast": {
          "name": "Claude Opus 5 Fast"
        },

        "moonshotai/kimi-k3": {
          "name": "Kimi K3"
        },

        "deepseek/deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro 0813"
        },
	"qwen/qwen3.8-max-free": {
	  "name": "Qwen Max 3.8 Free"
	}
      }
    }
  },

  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pytest*": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "git push*": "deny"
    }
  }
}